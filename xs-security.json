{
  "scopes": [
    {
      "name": "$XSAPPNAME.admin",
      "description": "Full Migration Factory Admin access (setup, discovery, wave planning, post-approval deployment)"
    },
    {
      "name": "$XSAPPNAME.approver",
      "description": "Migration Factory Approver access (read evidence, approve or reject plans and deployments)"
    },
    {
      "name": "$XSAPPNAME.viewer",
      "description": "Migration Factory Viewer access (read-only access to discovered interfaces, reports, and grounded chat)"
    },
    {
      "name": "$XSAPPNAME.mtcallback",
      "description": "Subscription via SaaS Registry",
      "grant-as-authority-to-apps": [
        "$XSAPPNAME(application,sap-provisioning,tenant-onboarding)"
      ]
    },
    {
      "name": "$XSAPPNAME.emcallback",
      "description": "Enterprise-Messaging Callback Access",
      "grant-as-authority-to-apps": [
        "$XSSERVICENAME(AICONX-messaging)"
      ]
    },
    {
      "name": "$XSAPPNAME.emmanagement",
      "description": "Enterprise-Messaging Management Access"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "admin",
      "description": "Migration Factory Administrator",
      "scope-references": [
        "$XSAPPNAME.admin"
      ],
      "attribute-references": []
    },
    {
      "name": "approver",
      "description": "Migration Factory Approver",
      "scope-references": [
        "$XSAPPNAME.approver"
      ],
      "attribute-references": []
    },
    {
      "name": "viewer",
      "description": "Migration Factory Viewer",
      "scope-references": [
        "$XSAPPNAME.viewer"
      ],
      "attribute-references": []
    }
  ],
  "authorities": [
    "$XSAPPNAME.emmanagement",
    "$XSAPPNAME.mtcallback"
  ]
}
