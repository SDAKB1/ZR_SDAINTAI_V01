{
  "name": "sdaintai-mtx-sidecar",
  "version": "1.0.0",
  "description": "MTX Sidecar for SDAINTAI Multi-Tenant SaaS",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": "/app/db-data/mtx.sqlite" }
      },
      "[production]": {
        "db": "hana"
      },
      "cds.xt.SaasProvisioningService": true,
      "cds.xt.DeploymentService": true,
      "cds.xt.ModelProviderService": true
    },
    "mtx": {
      "api": {
        "provisioning": true,
        "model": true,
        "diagnose": true
      }
    }
  }
}
