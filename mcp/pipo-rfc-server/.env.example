# Copy to .env for local testing only — never commit a real .env.
# On Cloud Foundry, set these with `cf set-env sdaintai-pipo-rfc-mcp <KEY> <VALUE>`
# then `cf restage sdaintai-pipo-rfc-mcp`, not via this file.

# Basic Auth users calling this MCP server — defaults match server.js if unset
MCP_USER_1=AYMANK
MCP_PASS_1=AYMANK
MCP_USER_2=SAIREDDY
MCP_PASS_2=SAIREDDY

# --- PI8 (PJ2, PI/PO) — NOT an env var ------------------------------------
# /api/pi8/ping and /api/pi8/objects don't read any env var here. They go
# through Cloud Connector destinations PO_PJ2_ESR / PO_PJ2_DIR, which must
# already exist in your BTP subaccount's destination configuration and be
# reachable via a destination-service instance bound to this app (see
# `services:` in manifest.yml — defaults to the existing AICONX-destination
# instance). If you're cloning this repo into a different subaccount, those
# two destinations need to be recreated there first (Cloud Connector virtual
# host for PJ2, ProxyType OnPremise) — see README.md.

# --- Generic RFC/BAPI calls (call_rfc/get_rfc_metadata) — optional --------
# Not needed for PI8. Fill in only if you also want the generic RFC bridge
# working against a real system reachable by direct RFC (ASHOST).
SDAINTAI_SAP_ASHOST=
SDAINTAI_SAP_SYSNR=00
SDAINTAI_SAP_CLIENT=
SDAINTAI_SAP_USER=
SDAINTAI_SAP_PASSWD=

# SDADATAAI — leave blank until that system is wired up later
SDADATAAI_SAP_ASHOST=
SDADATAAI_SAP_SYSNR=
SDADATAAI_SAP_CLIENT=
SDADATAAI_SAP_USER=
SDADATAAI_SAP_PASSWD=
