{
  "name": "AICONX",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@cap-js/audit-logging": ">=0",
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@sap/xssec": "^4",
    "kafkajs": "^2",
    "langchain": "^1.5.2",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": "db/sdaintai.sqlite" }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana",
        "multitenancy": true
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "messaging": {
        "kind": "enterprise-messaging"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "portal": true,
      "application-logging": true
    },
    "profile": "with-mtx-sidecar"
  }
}
